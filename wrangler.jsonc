{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-webstack-admin",
	"main": "src/index.js",
	"compatibility_date": "2026-10-17",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "webstack-nav-db",
			"database_id": "f43add59-af23-4ae3-b653-c4aa70aa247f"
		},
		{
			"binding": "webstack_nav_db",
			"database_name": "webstack-nav-db",
			"database_id": "f43add59-af23-4ae3-b653-c4aa70aa247f",
			"remote": true
		}
	]
}